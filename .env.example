# Application URL
NEXT_PUBLIC_APP_URL="https://mynextwhip.onrender.com"

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://user:password@localhost:5432/mynextwhip?schema=public"

# Authentication Secrets
AUTH_SECRET="your-super-secret-auth-key-32-chars-minimum"

# Stripe Payments (Standard Listing Fee $19, Boosts)
STRIPE_SECRET_KEY="sk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Cloudflare R2 / AWS S3 Object Storage (Photos, Cold-Start Videos, Documents)
STORAGE_ACCESS_KEY="your-storage-access-key"
STORAGE_SECRET_KEY="your-storage-secret-key"
STORAGE_BUCKET="mynextwhip-media"
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# VIN Decoding API (NHTSA vPIC Public API is default; custom provider key optional)
VIN_API_KEY=""

# Geocoding & Mapping API
MAPS_API_KEY=""

# Transactional Email (Resend)
EMAIL_API_KEY="re_123456789"

